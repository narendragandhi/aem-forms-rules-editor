{
  "AEM Forms Rule": {
    "prefix": "cfrule",
    "body": [
      "// WHEN ${1:condition} THEN ${2:action}",
      "if (${3:condition}) {",
      "    ${4:// action}",
      "}"
    ],
    "description": "AEM Forms Rule template"
  },
  "AEM Validate Function": {
    "prefix": "cfvalidate",
    "body": [
      "CustomFormRules.${1|validateSSN,validateEIN,validateITIN,validateCreditCardLuhn,validateCanadianSIN,validateIBAN,validateIPv6|}(${2:value})"
    ],
    "description": "Call a validation function"
  },
  "AEM Format Function": {
    "prefix": "cfformat",
    "body": [
      "CustomFormRules.${1|formatPhoneNumber,formatSSN,formatCreditCard,maskCreditCard,formatCurrency,formatDate,formatDateISO,formatZipCodePlus4,formatNumberWithCommas|}(${2:value})"
    ],
    "description": "Call a formatting function"
  },
  "AEM Async Function Call": {
    "prefix": "cfasync",
    "body": [
      "CustomFormRules.${1:namespace}.${2:functionName}(${3:params}).then(function(result) {",
      "    ${4:// handle result}",
      "}).catch(function(err) {",
      "    console.error(err);",
      "});"
    ],
    "description": "Call an async function with Promise handling"
  },
  "AEM Multi-Source Prefill": {
    "prefix": "cfprefill",
    "body": [
      "CustomFormRules.formsPortal.prefillsFormFromMultipleSources([${1:\"user-profile\"}, ${2:\"customer-data\"}]).then(function(data) {",
      "    ${3:// use data.data}",
      "});"
    ],
    "description": "Prefill form from multiple data sources"
  },
  "AEM Auto-Save Draft": {
    "prefix": "cfdraft",
    "body": [
      "var autoSave = CustomFormRules.formsPortal.createAutoSaver(",
      "    \"${1:/content/forms/af/form-name}\",",
      "    \"${2:userId}\",",
      "    ${3:30000}",
      ");",
      "",
      "// Call autoSave(formData) on field change"
    ],
    "description": "Set up auto-save for form drafts"
  },
  "AEM Generate DoR": {
    "prefix": "cfdor",
    "body": [
      "CustomFormRules.documentOfRecord.autoGenerateDoR(",
      "    \"${1:/content/forms/af/form-name}\",",
      "    \"${2:submission-id}\"",
      ").then(function(dor) {",
      "    console.log(\"DoR generated:\", dor.dorId);",
      "});"
    ],
    "description": "Auto-generate Document of Record"
  },
  "AEM Generate Correspondence": {
    "prefix": "cfcorr",
    "body": [
      "CustomFormRules.correspondence.generateCorrespondence(",
      "    \"${1:LTR-US-001}\",",
      "    \"${2:recipient-id}\"",
      ").then(function(result) {",
      "    console.log(\"Generated:\", result.correspondenceId);",
      "});"
    ],
    "description": "Generate a correspondence from template"
  }
}
